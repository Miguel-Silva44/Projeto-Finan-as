# Generate .env.dev/.env.hml/.env.prod with scripts/new-environment.ps1.
# Secrets are random files under data/secrets/<environment>, never in this file.
FINANCE_ENV=dev
SPRING_PROFILES_ACTIVE=dev,postgres
POSTGRES_DB=financas
APP_PORT=8080
DB_PORT=5432
BASE_URL=http://localhost:8080
COOKIE_SECURE=false
MAIL_MODE=file
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_TLS=false
MAIL_FROM=acesso@financas.local
BACKUP_DIRECTORY=./data/backups/dev
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=90
